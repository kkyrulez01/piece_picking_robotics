<?xml version="1.0"?>

<sdf version="1.9">

  <model name="blue_rectangular_box">

    <static>false</static>

    <link name="block_link">

      <inertial>
        <mass>0.1</mass>

        <inertia>
          <ixx>0.00004167</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>

          <iyy>0.00004167</iyy>
          <iyz>0.0</iyz>

          <izz>0.00004167</izz>
        </inertia>
      </inertial>

      <collision name="block_collision">
        <geometry>
          <box>
            <size>0.05 0.05 0.05</size>
          </box>
        </geometry>

        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <visual name="block_visual">
        <geometry>
          <box>
            <size>0.05 0.05 0.05</size>
          </box>
        </geometry>

        <material>
          <ambient>0 0 1 1</ambient>
          <diffuse>0 0 1 1</diffuse>
          <specular>0 0 0.2 1</specular>
        </material>

      </visual>

    </link>

    <plugin
        filename="gz-sim-label-system"
        name="gz::sim::systems::Label">

        <label>1</label>

    </plugin>
    
  </model>

</sdf>