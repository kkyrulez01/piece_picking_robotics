<?xml version="1.0"?>
<robot name="rectangular_box">
  <link name="block_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.1"/>
      <!-- Inertia for a solid cube: I = 1/12 * m * (w^2 + d^2) -->
      <inertia ixx="0.0000416" ixy="0.0" ixz="0.0" 
               iyy="0.0000416" iyz="0.0" 
               izz="0.0000416"/>
    </inertial>
    
    <visual>
      <geometry>
        <box size="0.05 0.05 0.05"/>
      </geometry>

      <material name="blue">
        <color rgba="0 0 1 1"/>
      </material>

      <!-- For labelling-->
      <plugin filename="gz-sim-label-system" name="gz::sim::systems::Label">
        <label>1</label>
      </plugin>
    </visual>
    
    <collision>
      <geometry>
        <box size="0.05 0.05 0.05"/>
      </geometry>
      <!-- Friction properties for Gazebo Harmonic -->
      <surface>
        <friction>
          <ode>
            <mu>1.0</mu>
            <mu2>1.0</mu2>
          </ode>
        </friction>
      </surface>
    </collision>
  </link>
  
  <gazebo reference="block_link">
    <material>Gazebo/Blue</material>
  </gazebo>
</robot>