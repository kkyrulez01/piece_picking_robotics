<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="ARC">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import ARC urdf file -->
    <xacro:include filename="$(find arc_robot_pkg)/ARC_S6/ARC.urdf.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="ARC.ros2_control.xacro" />


    <xacro:ARC_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
